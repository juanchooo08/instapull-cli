# Copia este archivo como .env y completa los valores.
# El archivo .env NO se sube al repositorio (ver .gitignore).

# Clave de OpenRouter (obligatoria para el analisis con IA)
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Credenciales de Instagram. Si las dejas vacias, se piden por consola
# la primera vez que corras `instapull login`.
IG_USERNAME=
IG_PASSWORD=

# Clave de Resend. Solo hace falta si activas el resumen diario por correo
# (email.enabled: true en config.yaml).
RESEND_API_KEY=
IG_SESSIONID=
